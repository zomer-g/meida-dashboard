# Local development. On xhostd, set these in the console (Environment) or with set_env; secrets as secrets.

# Postgres. xhostd injects DATABASE_URL per channel; locally `npm run db:local` serves PGlite on 5434.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/postgres

# Auth — xhostd SSO (Google). Comma separated.
ADMIN_EMAILS=
# Hostnames the identity cookie may be minted for, e.g. meida-dashboard-zomerg.xhostd.app
XHOST_AUTH_AUDIENCES=
# next dev only: act as this email (there is no xhostd sign-in on localhost).
DEV_AUTH_EMAIL=

# Background sync worker (launch.sh). Only one instance per database.
SYNC_WORKER=true
SYNC_INTERVAL_MIN=10
MARKETING_SYNC_INTERVAL_MIN=360
# Import seed/*.csv on boot when the requests table is empty.
SEED_ON_EMPTY=true

# Salesforce — docs/setup-salesforce.md
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=65.0

# Google Analytics 4 — docs/setup-google-analytics.md
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Locally, a path to the key file instead of pasting it (keep it in .secrets/, which is gitignored).
GOOGLE_SERVICE_ACCOUNT_FILE=
GA_START_DAY=2024-01-01

# SMOOV — docs/setup-smoov.md
SMOOV_API_KEY=
